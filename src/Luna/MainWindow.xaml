<ui:FluentWindow x:Class="Luna.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Luna" Height="620" Width="940" MinHeight="540" MinWidth="760"
                 WindowBackdropType="Mica" WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Luna" />

        <Grid Grid.Row="1" Margin="28,8,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="22">
                <StackPanel>
                    <TextBlock Text="COMPTE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Content="Hors-ligne" Margin="0,0,6,0"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Command="{Binding UseOfflineCommand}"
                                   Appearance="{Binding OfflineAppearance}" />
                        <ui:Button Grid.Column="1" Content="Microsoft" Margin="6,0,0,0"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Command="{Binding UseMicrosoftCommand}"
                                   Appearance="{Binding MicrosoftAppearance}" />
                    </Grid>

                    <TextBlock Text="Pseudo" FontSize="12" Margin="0,0,0,6"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox PlaceholderText="Trois caracteres minimum"
                                Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{Binding UuidText}" FontSize="11" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />

                    <ui:Button Content="Se connecter avec Microsoft" Margin="0,18,0,0"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Command="{Binding ConnectMicrosoftCommand}" />
                </StackPanel>
            </ui:Card>

            <Grid Grid.Column="1" Margin="24,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Padding="22">
                    <StackPanel>
                        <TextBlock Text="VERSION" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding VersionText}"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:Card>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,0,12"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                    <ui:Button Content="JOUER" Appearance="Primary" FontSize="16" FontWeight="SemiBold"
                               Height="48" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               Command="{Binding PlayCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>